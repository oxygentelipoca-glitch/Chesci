FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --extra postgres --no-install-project

COPY app ./app
COPY scripts/extract_scifinder_llm.py scripts/seed_chemistry.py ./scripts/
COPY docs/demo-routes.json docs/published-cinnamic-acid.json ./docs/
COPY utils ./utils

RUN mkdir -p documents vector_db chemistry_data

EXPOSE 8000

CMD ["/app/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
