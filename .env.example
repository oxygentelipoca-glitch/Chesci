# Local SQLite defaults are used when DATABASE_URL / CHEMISTRY_DB_URL are unset.
DATABASE_URL=sqlite:///database.db
CHEMISTRY_DB_URL=sqlite:///reactions.db

# Required only for LLM analysis and experiment plan generation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Change this before exposing the service outside local development.
JWT_SECRET=replace-with-a-random-secret

# Optional knowledge graph connection.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional retrieval tuning.
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_MAX_DENSE_DISTANCE=1.05
RAG_MIN_BM25_SCORE=8.0
